{
  "version": "v4.0",
  "states": [
    {
      "name": "待执行",
      "definition": "任务已创建、未执行",
      "allowed": [
        "详情",
        "编辑",
        "执行",
        "取消"
      ],
      "primary": "编辑/执行/取消",
      "note": "不含预检失败独立状态"
    },
    {
      "name": "排队中",
      "definition": "已入调度队列、未真正执行",
      "allowed": [
        "详情",
        "取消"
      ],
      "primary": "取消",
      "note": "不允许再次执行"
    },
    {
      "name": "执行中",
      "definition": "执行器正在自动发布",
      "allowed": [
        "详情",
        "取消"
      ],
      "primary": "取消（有条件）",
      "note": "不显示重试、暂停"
    },
    {
      "name": "等待人工",
      "definition": "因登录、验证等阻塞、需要人工操作",
      "allowed": [
        "详情",
        "去处理",
        "取消"
      ],
      "primary": "去处理",
      "note": "去处理后可能恢复原尝试或结果待确认"
    },
    {
      "name": "结果待确认",
      "definition": "不能证明已发布或未发布",
      "allowed": [
        "详情",
        "核实结果"
      ],
      "primary": "核实结果",
      "note": "不能重试、取消、复制或释放占用"
    },
    {
      "name": "平台审核中",
      "definition": "平台已接收投稿、等待审核/公开",
      "allowed": [
        "详情"
      ],
      "primary": "无",
      "note": "不作为已发布、不允许复制"
    },
    {
      "name": "发布失败",
      "definition": "原执行已结束且确认未成功发布",
      "allowed": [
        "详情",
        "重试",
        "复制"
      ],
      "primary": "重试（有条件）",
      "note": "按钮文案不叫安全重试"
    },
    {
      "name": "已发布",
      "definition": "已确认公开发布",
      "allowed": [
        "详情",
        "复制"
      ],
      "primary": "无",
      "note": "缺有效作品链接不能提供查看作品假入口"
    },
    {
      "name": "已取消",
      "definition": "已确认任务安全终止",
      "allowed": [
        "详情",
        "复制"
      ],
      "primary": "无",
      "note": "不代表资源已释放"
    },
    {
      "name": "已放弃",
      "definition": "任务终止、资源已按既有安全规则释放",
      "allowed": [
        "详情",
        "复制"
      ],
      "primary": "无",
      "note": "不允许恢复旧任务"
    }
  ],
  "actions": [
    "详情",
    "编辑",
    "执行",
    "取消",
    "去处理",
    "核实结果",
    "重试",
    "复制"
  ],
  "pauseSupported": false,
  "copyTerminalStates": [
    "发布失败",
    "已发布",
    "已取消",
    "已放弃"
  ],
  "transitions": [
    {
      "source": "待执行",
      "event": "用户点击执行、校验通过",
      "target": "排队中",
      "guard": "创建任务不自动执行"
    },
    {
      "source": "待执行",
      "event": "保存编辑",
      "target": "待执行",
      "guard": "仅增加内容版本"
    },
    {
      "source": "待执行",
      "event": "安全取消",
      "target": "已取消",
      "guard": "仍可能保留资源占用"
    },
    {
      "source": "排队中",
      "event": "调度器成功领取",
      "target": "执行中",
      "guard": "幂等、避免竞争"
    },
    {
      "source": "排队中",
      "event": "成功撤队",
      "target": "已取消",
      "guard": "必须证明未开始"
    },
    {
      "source": "执行中",
      "event": "需要人工登录/验证",
      "target": "等待人工",
      "guard": "自动任务挂起"
    },
    {
      "source": "等待人工",
      "event": "验证完成且确认未投稿",
      "target": "执行中",
      "guard": "继续原执行尝试"
    },
    {
      "source": "等待人工",
      "event": "可能已提交或结果未知",
      "target": "结果待确认",
      "guard": "禁止再次提交"
    },
    {
      "source": "执行中",
      "event": "平台接收且等待审核",
      "target": "平台审核中",
      "guard": "有平台接收证据"
    },
    {
      "source": "执行中",
      "event": "平台确认已公开",
      "target": "已发布",
      "guard": "有公开成功证据"
    },
    {
      "source": "执行中",
      "event": "已结束且未成功",
      "target": "发布失败",
      "guard": "失败已确认；不是未知"
    },
    {
      "source": "执行中",
      "event": "提交结果未知",
      "target": "结果待确认",
      "guard": "重复投稿防护"
    },
    {
      "source": "执行中",
      "event": "安全停止成功",
      "target": "已取消",
      "guard": "不可证明安全时转结果待确认或拒绝取消"
    },
    {
      "source": "等待人工",
      "event": "安全终止成功",
      "target": "已取消",
      "guard": "不可证明安全时转结果待确认或拒绝"
    },
    {
      "source": "平台审核中",
      "event": "审核通过且公开",
      "target": "已发布",
      "guard": "不能直接以投稿成功判已发布"
    },
    {
      "source": "平台审核中",
      "event": "平台确认审核失败",
      "target": "发布失败",
      "guard": "必须确认未公开"
    },
    {
      "source": "结果待确认",
      "event": "人工确认已公开、有证据",
      "target": "已发布",
      "guard": "作品链接优先，ID+证据仅按平台规则例外"
    },
    {
      "source": "结果待确认",
      "event": "人工确认已接收待审核",
      "target": "平台审核中",
      "guard": "需投稿凭据"
    },
    {
      "source": "结果待确认",
      "event": "人工确认未发布且执行结束",
      "target": "发布失败",
      "guard": "失败原因和核实依据"
    },
    {
      "source": "结果待确认",
      "event": "仍无法判断",
      "target": "结果待确认",
      "guard": "记录人工核实，继续阻断重试"
    },
    {
      "source": "发布失败",
      "event": "点击重试、校验通过",
      "target": "排队中",
      "guard": "增加执行尝试，不覆盖原记录"
    },
    {
      "source": "已取消",
      "event": "既有安全释放/放弃流程完成",
      "target": "已放弃",
      "guard": "仅遵守现有设计基线；不新增按钮/不假设自动释放"
    }
  ]
}