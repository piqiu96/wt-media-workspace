# T-04 cloud bin/control.sh 读数
# 仓: wt-media-cloud  日期: 2026-09-26
# 取数时 bin/control.sh、scripts/dev|verify、.gitignore 改动都在工作树里，未提交

## ARM 1 — status（真实树，未运行／或跑在别处）
$ bash bin/control.sh status
cloud: pid=- alive=no health=ok url=http://127.0.0.1:18080/healthz
exit=1

## 读数时的旁证
$ cat .cache/wt-media-cloud.pid
13457
$ kill -0 $(cat .cache/wt-media-cloud.pid)
(eval):kill:19: kill 13457 failed: no such process
exit=1 (dead)
$ lsof -nP -iTCP:18080 -sTCP:LISTEN
COMMAND   PID   USER   FD   TYPE            DEVICE SIZE/OFF NODE NAME
server  54420 aqiuye    8u  IPv4 0xe262d1cf13be4be      0t0  TCP 127.0.0.1:18080 (LISTEN)
server  54420 aqiuye    9u  IPv4 0xe262d1cf13be4be      0t0  TCP 127.0.0.1:18080 (LISTEN)

## ARM 2 — stop（真实树）
$ bash bin/control.sh stop
wt-media-cloud stopped
exit=0

## ARM 3 — status（stop 之后）
$ bash bin/control.sh status
cloud: pid=- alive=no health=ok url=http://127.0.0.1:18080/healthz
exit=1

## ARM 4-9 — 隔离全套：start|status|restart|status|stop|status
# 覆盖三个 env 落点（PID/LOG/BINARY）到 /private/tmp/t04，地址覆盖到 :18999（仓内端口值未动）
# PATH 前置模拟 go（/private/tmp/t04-sim/bin/go）：只实现 'go build -o <f> ./cmd/server'，
# 产出的可执行体在 WT_MEDIA_CLOUD_HTTP_ADDR 的端口上起 python3 -m http.server（每路径 200）
